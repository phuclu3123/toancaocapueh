# Server Configuration
PORT=3001
NODE_ENV=production

# MongoDB Connection String (Atlas Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DIRECT_URI=

# Client URLs (CORS)
CLIENT_URL=https://toancaocapueh.id.vn
FRONTEND_URL=https://toancaocapueh.id.vn

# Email Service Configuration (Resend or Gmail SMTP)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=UEH TCC Helper <onboarding@resend.dev>
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
